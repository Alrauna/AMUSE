{
  "schemaVersion": 2,
  "name": "Aggressive",
  "description": "Accepts desktop and mobile anisotropy differences, slot exceptions, and depth-test changes.",
  "features": {
    "alphaSeparator": true
  },
  "settings": {
    "preserveTransparencyMaxMipLevel": 4,
    "preserveTransparencyMinTextureSize": 128,
    "minimumOpaqueCoveragePercent": 25,
    "minimumOpaqueAlphaPercent": 95,
    "polygonAlphaUpperClampPercent": 94,
    "polygonMinimumOpaqueCoveragePercent": 95,
    "allowDepthTestChange": true,
    "ignoreOutOfRangeMaterialSlots": true,
    "acceptDesktopAnisotropyDifferences": true,
    "acceptMobileAnisotropyDifferences": true
  }
}
