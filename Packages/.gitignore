!com.alrauna.amuse

# First-party research tooling. Public source, never released; see its
# package.json. Excluded from releases by the workflows, which build only the
# single package they are configured with, not by being untracked here.
!com.alrauna.amuse.research

# Vendor packages are a permanent part of the dev environment. The test
# suites run against the installed set (Poiyomi, Thry, VRCFury, Modular
# Avatar, and the rest of the locked block of vpm-manifest.json).
# Explicit so a future whitelist edit cannot expose them.
com.poiyomi.*
com.vrcfury.*
nadena.dev.modular-avatar
